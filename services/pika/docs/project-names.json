{
	"description": "A session's project name from git's common dir (SPEC.md, `meta.project`), shared by pika's projectFromCommonDir and Herder's repositoryName tests. `expected: null` means no name.",
	"cases": [
		{ "commonDir": "/home/me/pi-extensions/.git", "expected": "pi-extensions", "case": "main checkout and its linked worktrees" },
		{ "commonDir": "/home/me/pi-extensions/.git/", "expected": "pi-extensions", "case": "trailing slash" },
		{ "commonDir": "/home/me/pi-extensions/.git//", "expected": "pi-extensions", "case": "trailing slashes" },
		{ "commonDir": "/srv/git/tool.git", "expected": "tool", "case": "bare repository" },
		{ "commonDir": "/srv/git/tool.git/", "expected": "tool", "case": "bare repository, trailing slash" },
		{ "commonDir": "/srv/git/tool.git.git", "expected": "tool.git", "case": "only one .git is removed" },
		{ "commonDir": "/srv/git/tool", "expected": "tool", "case": "bare repository without .git" },
		{ "commonDir": "/srv/git/.git.git", "expected": ".git", "case": "bare repository named .git.git" },
		{ "commonDir": "/home/me/super/.git/modules/lib", "expected": "lib", "case": "submodule" },
		{ "commonDir": "/home/me/super/.git/modules/lib/", "expected": "lib", "case": "submodule, trailing slash" },
		{ "commonDir": "/home/me/my repo/.git", "expected": "my repo", "case": "inner space" },
		{ "commonDir": "/code/仓库/.git", "expected": "仓库", "case": "non-ASCII" },
		{ "commonDir": "/code/a:b/.git", "expected": "a:b", "case": "colon inside a path" },
		{ "commonDir": "C:\\code\\app\\.git", "expected": "app", "case": "Windows separators" },
		{ "commonDir": "C:\\code\\app\\.git\\", "expected": "app", "case": "Windows separators, trailing backslash" },
		{ "commonDir": "C:/code/tool.git", "expected": "tool", "case": "Windows drive, forward slashes" },
		{ "commonDir": "\\\\server\\share\\app\\.git", "expected": "app", "case": "UNC path" },
		{ "commonDir": "/srv/a\\b/.git", "expected": "b", "case": "a backslash separates on every platform" },
		{ "commonDir": "/.git", "expected": null, "case": "repository at the root" },
		{ "commonDir": "C:\\.git", "expected": null, "case": "repository at a drive root" },
		{ "commonDir": "/", "expected": null, "case": "root" },
		{ "commonDir": "", "expected": null, "case": "empty" },
		{ "commonDir": ".git", "expected": null, "case": "relative .git gives ." },
		{ "commonDir": "/srv/git/..git", "expected": null, "case": "name ." },
		{ "commonDir": "/srv/git/...git", "expected": null, "case": "name .." },
		{ "commonDir": "/srv/git/.git/..", "expected": null, "case": "unresolved .." },
		{ "commonDir": "/srv/ /.git", "expected": null, "case": "blank name" },
		{ "commonDir": "/srv/  .git", "expected": null, "case": "blank bare repository name" },
		{ "commonDir": "/srv/\u3000/.git", "expected": null, "case": "ideographic space only" },
		{ "commonDir": "/srv/a\nb/.git", "expected": null, "case": "C0 control" },
		{ "commonDir": "/srv/a\u007fb/.git", "expected": null, "case": "DEL" },
		{ "commonDir": "/srv/a\u0085b/.git", "expected": null, "case": "C1 control" },
		{ "commonDir": "/srv/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.git", "expected": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "case": "255 bytes" },
		{ "commonDir": "/srv/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/.git", "expected": null, "case": "256 bytes" }
	]
}
