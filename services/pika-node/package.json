{
	"name": "pika-node",
	"version": "0.1.0",
	"private": true,
	"description": "pika node daemon: PTYs, headless screens, files, and pane status, reached end to end through the pika server (services/pika/docs/NODE.md).",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^24.12.0",
		"@types/ws": "^8.18.2",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@xterm/addon-serialize": "0.14.0",
		"@xterm/addon-unicode-graphemes": "0.4.0",
		"@xterm/headless": "6.0.0",
		"node-pty": "^1.1.0",
		"ws": "^8.22.2"
	},
	"allowScripts": {
		"node-pty@1.1.0": true
	}
}
