{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2023",
		"allowImportingTsExtensions": true,
		"jsx": "react-jsx",
		"jsxImportSource": "orca",
		"types": ["node"]
	},
	"include": ["extensions", "plugins/pika-relay/src", "plugins/pika-relay/tests"],
	"exclude": [
		"extensions/subagents"
	]
}
