{
	"name": "pi-extensions",
	"version": "0.2.0",
	"description": "Maintained Pi extensions for durable verified orchestration, academic writing, status telemetry, native compaction, and sub-agents",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"herder",
		"multi-agent",
		"subagents",
		"magpie",
		"compaction",
		"writer",
		"academic"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "npm run test:orca-bridge && npm run test:magpie-provider && npm run test:commit && npm run test:quality && npm run test:statusline && npm run test:loop && npm run test:molt && npm run test:autoresearch && npm run test:subagents && npm run test:herder && npm run test:writer && npm run test:pika && npm run test:relay && npm run test:impeccable",
		"test:impeccable": "vitest run --config extensions/impeccable/vitest.config.ts",
		"test:impeccable:package": "vitest run --config extensions/impeccable/vitest.package.config.ts",
		"test:impeccable:visual-foundations": "vitest run --config extensions/impeccable/vitest.visual-foundations.config.ts",
		"test:impeccable:engine": "vitest run --config extensions/impeccable/vitest.engine.config.ts",
		"test:impeccable:contracts": "vitest run --config extensions/impeccable/vitest.config.ts extensions/impeccable/tests/contracts.test.ts",
		"test:orca-bridge": "vitest run extensions/orca-bridge",
		"test:magpie-provider": "vitest run extensions/magpie-provider",
		"test:commit": "node --experimental-strip-types --test extensions/commit/tests/*.test.ts",
		"test:quality": "node --experimental-strip-types --test extensions/quality/tests/*.test.ts",
		"test:simplify": "npm run test:quality",
		"test:writer": "node --experimental-strip-types --test extensions/writer/tests/*.test.ts",
		"test:statusline": "vitest run extensions/statusline-footer/tests/statusline-footer.test.ts",
		"test:loop": "vitest run extensions/loop",
		"test:molt": "vitest run extensions/molt",
		"test:autoresearch": "vitest run extensions/autoresearch",
		"test:subagents": "vitest run --config extensions/subagents/vitest.config.ts",
		"test:pika": "vitest run extensions/pika",
		"test:relay": "vitest run extensions/relay",
		"test:herder": "vitest run --config extensions/herder/vitest.config.ts",
		"typecheck": "tsc -p tsconfig.json && npm run typecheck:subagents",
		"typecheck:subagents": "tsc -p extensions/subagents/tsconfig.json"
	},
	"dependencies": {
		"croner": "^10.0.1",
		"nanoid": "^5.1.16"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "^1.4.0",
		"@earendil-works/pi-ai": "^1.4.0",
		"@earendil-works/pi-coding-agent": "^1.4.0",
		"@earendil-works/pi-tui": "^1.4.0",
		"@sinclair/typebox": "^0.34.52",
		"@types/node": "^24.12.0",
		"@types/ws": "^8.18.2",
		"typebox": "^1.3.27",
		"playwright-core": "1.56.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11",
		"ws": "^8.22.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=1.3.0",
		"@earendil-works/pi-coding-agent": ">=1.3.0",
		"@earendil-works/pi-tui": ">=1.3.0",
		"@sinclair/typebox": "*",
		"typebox": "*"
	},
	"pi": {
		"themes": ["./themes"],
		"skills": ["./extensions/herder/skills", "./extensions/impeccable/skills"],
		"prompts": [
			"./extensions/commit/prompts/commit.md",
			"./extensions/quality/prompts/simplify.md",
			"./extensions/quality/prompts/review.md",
			"./extensions/quality/prompts/verify.md",
			"./extensions/quality/prompts/deslop.md",
			"./extensions/writer/prompts/conference-reviewer.md",
			"./extensions/writer/prompts/evaluate.md",
			"./extensions/writer/prompts/grammar-checker.md",
			"./extensions/writer/prompts/paper-validator.md",
			"./extensions/writer/prompts/polish.md",
			"./extensions/writer/prompts/selection.md",
			"./extensions/writer/prompts/summary.md",
			"./extensions/writer/prompts/validation.md",
			"./extensions/impeccable/prompts/design.md",
			"./extensions/impeccable/prompts/design-adapt.md",
			"./extensions/impeccable/prompts/design-animate.md",
			"./extensions/impeccable/prompts/design-audit.md",
			"./extensions/impeccable/prompts/design-bolder.md",
			"./extensions/impeccable/prompts/design-clarify.md",
			"./extensions/impeccable/prompts/design-colorize.md",
			"./extensions/impeccable/prompts/design-craft.md",
			"./extensions/impeccable/prompts/design-critique.md",
			"./extensions/impeccable/prompts/design-delight.md",
			"./extensions/impeccable/prompts/design-distill.md",
			"./extensions/impeccable/prompts/design-document.md",
			"./extensions/impeccable/prompts/design-extract.md",
			"./extensions/impeccable/prompts/design-generate.md",
			"./extensions/impeccable/prompts/design-harden.md",
			"./extensions/impeccable/prompts/design-init.md",
			"./extensions/impeccable/prompts/design-layout.md",
			"./extensions/impeccable/prompts/design-live.md",
			"./extensions/impeccable/prompts/design-onboard.md",
			"./extensions/impeccable/prompts/design-optimize.md",
			"./extensions/impeccable/prompts/design-overdrive.md",
			"./extensions/impeccable/prompts/design-polish.md",
			"./extensions/impeccable/prompts/design-quieter.md",
			"./extensions/impeccable/prompts/design-shape.md",
			"./extensions/impeccable/prompts/design-typeset.md",
			"./extensions/impeccable/prompts/impeccable.md"
		],
		"extensions": [
			"./extensions/orca-bridge/index.ts",
			"./extensions/magpie-provider/index.ts",
			"./extensions/statusline-footer/index.ts",
			"./extensions/loop/index.ts",
			"./extensions/molt/index.ts",
			"./extensions/autoresearch/index.ts",
			"./extensions/subagents/src/index.ts",
			"./extensions/herder/index.ts",
			"./extensions/impeccable/index.ts",
			"./extensions/relay/index.ts",
			"./extensions/pika/index.ts"
		]
	}
}
