{
	"name": "pi-extensions",
	"version": "0.2.0",
	"description": "Maintained Pi extensions for deterministic multi-agent execution, status telemetry, native compaction, and sub-agents",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"herder",
		"multi-agent",
		"subagents",
		"cliproxyapi",
		"compaction"
	],
	"scripts": {
		"test": "npm run test:statusline && vitest run extensions/cliproxyapi-native-compaction/tests/native-compaction.test.ts && npm run test:herder",
		"test:statusline": "vitest run extensions/statusline-footer/tests/statusline-footer.test.ts",
		"test:herder": "node extensions/herder/tests/run-smoke.ts",
		"test:e2e:herder": "HERDER_LIVE_E2E=1 node --experimental-strip-types --test extensions/herder/tests/e2e/live-hosts.test.ts",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.52",
		"croner": "^10.0.1",
		"nanoid": "^5.1.16",
		"typebox": "^1.3.7"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "^0.84.1",
		"@earendil-works/pi-ai": "^0.84.1",
		"@earendil-works/pi-coding-agent": "^0.84.1",
		"@earendil-works/pi-tui": "^0.84.1",
		"@types/node": "^24.12.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.9"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"pi": {
		"extensions": [
			"./extensions/statusline-footer/index.ts",
			"./extensions/cliproxyapi-native-compaction/index.ts",
			"./extensions/herder/adapters/index.ts",
			"./extensions/subagents/src/index.ts"
		]
	}
}
