{
	"name": "pi-extensions",
	"version": "0.2.0",
	"description": "Maintained Pi extensions for deterministic multi-agent execution, academic writing, status telemetry, native compaction, and sub-agents",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"herder",
		"multi-agent",
		"subagents",
		"magpie",
		"compaction",
		"writer",
		"academic"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "npm run test:magpie-provider && npm run test:commit && npm run test:statusline && npm run test:subagents && npm run test:herder && npm run test:writer",
		"test:magpie-provider": "vitest run extensions/magpie-provider",
		"test:commit": "node --experimental-strip-types --test extensions/commit/tests/*.test.ts",
		"test:writer": "node --experimental-strip-types --test extensions/writer/tests/*.test.ts",
		"test:statusline": "vitest run extensions/statusline-footer/tests/statusline-footer.test.ts",
		"test:subagents": "vitest run --config extensions/subagents/vitest.config.ts",
		"test:herder": "node extensions/herder/tests/run-smoke.ts",
		"test:e2e:herder": "HERDER_LIVE_E2E=1 node --experimental-strip-types --test extensions/herder/tests/e2e/live-hosts.test.ts",
		"typecheck": "tsc -p tsconfig.json && npm run typecheck:subagents",
		"typecheck:subagents": "tsc -p extensions/subagents/tsconfig.json"
	},
	"dependencies": {
		"@ff-labs/pi-fff": "0.11.0",
		"croner": "^10.0.1",
		"nanoid": "^5.1.16"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "^1.3.0",
		"@earendil-works/pi-ai": "^1.3.0",
		"@earendil-works/pi-coding-agent": "^1.3.0",
		"@earendil-works/pi-server": "^1.0.0",
		"@earendil-works/pi-tui": "^1.3.0",
		"@sinclair/typebox": "^0.34.52",
		"@types/node": "^24.12.0",
		"typebox": "^1.3.27",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=1.3.0",
		"@earendil-works/pi-coding-agent": ">=1.3.0",
		"@earendil-works/pi-tui": ">=1.3.0",
		"@sinclair/typebox": "*",
		"typebox": "*"
	},
	"pi": {
		"themes": ["./themes"],
		"prompts": [
			"./extensions/commit/prompts/commit.md",
			"./extensions/writer/prompts/conference-reviewer.md",
			"./extensions/writer/prompts/evaluate.md",
			"./extensions/writer/prompts/grammar-checker.md",
			"./extensions/writer/prompts/paper-validator.md",
			"./extensions/writer/prompts/polish.md",
			"./extensions/writer/prompts/selection.md",
			"./extensions/writer/prompts/summary.md",
			"./extensions/writer/prompts/validation.md"
		],
		"extensions": [
			"./extensions/magpie-provider/index.ts",
			"./extensions/statusline-footer/index.ts",
			"./extensions/herder/adapters/index.ts",
			"./extensions/subagents/src/index.ts"
		]
	}
}
